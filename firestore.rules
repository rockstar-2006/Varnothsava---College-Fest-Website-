rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && (getUserData().role == role || getUserData().role == 'SUPER_ADMIN');
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'SUPER_ADMIN';
    }

    // --- COLLECTION: Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // --- COLLECTION: Events ---
    match /events/{eventId} {
      allow read: if true; // Public view
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        hasRole('COORDINATOR') && 
        request.auth.uid in resource.data.coordinators
      );
      allow delete: if isSuperAdmin();
    }

    // --- COLLECTION: Registrations ---
    match /registrations/{regId} {
      allow read: if isSuperAdmin() || (
        hasRole('COORDINATOR') && 
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.coordinators.hasAny([request.auth.uid])
      ) || (
        isSignedIn() && request.auth.uid in resource.data.members
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSuperAdmin() || (
        hasRole('COORDINATOR') && 
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.coordinators.hasAny([request.auth.uid])
      );
      
      allow delete: if isSuperAdmin();
    }

    // --- COLLECTION: Payments ---
    match /payments/{paymentId} {
      allow read: if isSuperAdmin() || hasRole('FINANCE') || (
        hasRole('COORDINATOR') && 
        // Logic to check if this payment belongs to a user in the coordinator's event
        // (Usually handled via server-side logic for complex filters, but basic read can be restricted)
        isSignedIn()
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSuperAdmin() || hasRole('FINANCE');
      
      allow delete: if isSuperAdmin();
    }

    // --- COLLECTION: Attendance ---
    match /attendance/{attendanceId} {
      allow read: if hasRole('VOLUNTEER') || hasRole('COORDINATOR');
      allow write: if hasRole('VOLUNTEER') || hasRole('COORDINATOR');
    }
  }
}
